# Điền ít nhất một khóa API để bật phân tích video bằng AI.
# Trên giao diện web có công tắc Claude / OpenAI để chọn AI dùng cho mỗi video.
# Để trống cả hai thì app dùng chế độ phân tích cơ bản (không AI).

# Claude — lấy khóa tại https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI — lấy khóa tại https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Cổng giao diện web (mặc định 3210).
# PORT=3210
