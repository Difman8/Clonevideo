# Điền ít nhất một khóa API để bật phân tích video bằng AI.
# Trên giao diện web có công tắc Claude / OpenAI để chọn AI dùng cho mỗi video.
# Để trống cả hai thì app dùng chế độ phân tích cơ bản (không AI).

# Claude — lấy khóa tại https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI — lấy khóa tại https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# YouTube Data API v3 — dùng cho tab "Tìm video hot" (miễn phí 10.000 đơn vị quota/ngày).
# Lấy khóa: mở https://console.cloud.google.com/apis/library/youtube.googleapis.com, bấm Enable,
# rồi vào APIs & Services → Credentials → Create credentials → API key.
# Có thể dán khóa ngay trên giao diện web thay vì sửa file này.
YOUTUBE_API_KEY=

# Cổng giao diện web (mặc định 3210).
# PORT=3210
